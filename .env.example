# ==============================================================================
# SHRIVA JEWELS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate the required values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / STOREFRONT (PUBLIC — Embedded in client browser bundle)
# ------------------------------------------------------------------------------
# Canonical production site domain (used for SEO canonical URLs & sitemap)
VITE_SITE_URL=https://www.shriva.store

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Brand Social Media URLs
VITE_INSTAGRAM_URL=https://www.instagram.com/shriva._jewels/
VITE_FACEBOOK_URL=https://www.facebook.com/
VITE_PINTEREST_URL=https://www.pinterest.com/

# Public Customer Care WhatsApp number (digits with country code, e.g. 919898384604)
VITE_WHATSAPP_NUMBER=919898384604

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND (PUBLIC URL & PUBLISHABLE ANON KEY)
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://uyskfaqrptwpnxzgisnn.supabase.co)
VITE_SUPABASE_URL=https://uyskfaqrptwpnxzgisnn.supabase.co

# Publishable anon key (safe for browser; authorization enforced via RLS)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. ADMIN DASHBOARD CONFIGURATION (admin.shriva.store)
# ------------------------------------------------------------------------------
VITE_ADMIN_URL=https://admin.shriva.store

# ------------------------------------------------------------------------------
# 4. CLOUDINARY IMAGE SERVICE (Image hosting, optimization & transformations)
# NOTE: Cloud name is public for image delivery; API Secret is STRICTLY SERVER-SIDE.
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=shriva_jewels

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay — India Payments Integration)
# Key ID is public for frontend checkout; Secret is STRICTLY SERVER-SIDE.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. WHATSAPP BUSINESS PLATFORM (Official Cloud API)
# Access Token and Account ID are strictly server-side / Edge Functions only.
# ------------------------------------------------------------------------------
# Provider: "mock" (logs and records mock delivery) or "cloud" (live Meta API delivery)
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_NUMBER=919898384604
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BOOKING_TEMPLATE_NAME=shriva_booking
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 7. LOCAL SERVER & DATABASE CONFIGURATION (Preserved Node Server)
# ------------------------------------------------------------------------------
PORT=8787
DATABASE_PATH=./data/shriva.db
BOOKING_RATE_LIMIT=10
