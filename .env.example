# ---------- Frontend (PUBLIC — these end up in the browser bundle; never put secrets here) ----------
VITE_SITE_URL=                 # e.g. https://www.shrivajewels.in  (canonical URLs, sitemap, robots)
VITE_INSTAGRAM_URL=https://www.instagram.com/shriva._jewels/
VITE_WHATSAPP_NUMBER=          # digits only with country code, e.g. 919XXXXXXXXX — for the customer "Message us on WhatsApp" wa.me button (public by nature)

# ---------- Server (SECRET — server-side only) ----------
PORT=8787
DATABASE_PATH=./data/shriva.db # SQLite file; must be on a persistent disk/volume in production
BOOKING_RATE_LIMIT=10          # max booking submissions per IP per hour

# "mock" logs the message and records notification_status="mock" (never "sent"). Use "cloud" for real delivery.
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_NUMBER=      # the number that RECEIVES booking alerts, digits only with country code
WHATSAPP_ACCESS_TOKEN=         # Meta system-user permanent token (secret)
WHATSAPP_PHONE_NUMBER_ID=      # sender phone-number ID from WhatsApp Manager
WHATSAPP_BUSINESS_ACCOUNT_ID=  # informational / template management
WHATSAPP_BOOKING_TEMPLATE_NAME= # approved template name (see README). If empty, free-text is sent (only works inside the 24h window)
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
